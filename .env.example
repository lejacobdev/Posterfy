# ---------------------------------------------------------------------------
# Posterfy environment
#
# Every value here is OPTIONAL. Without any configuration Posterfy still works:
# it falls back to the keyless MusicBrainz + Cover Art Archive provider and to
# fully manual entry. Add Spotify credentials for the best search results.
# ---------------------------------------------------------------------------

# Spotify application credentials (https://developer.spotify.com/dashboard).
# These are read by the server only and never shipped to the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Port for the bundled production server (`npm start`).
PORT=8080

# Comma separated list of origins allowed to call the API.
# Leave empty to allow same-origin requests only.
ALLOWED_ORIGINS=

# Contact address surfaced on the About/Privacy pages.
VITE_CONTACT_EMAIL=hello@posterfy.app

# Public site URL, used for canonical tags and the sitemap.
VITE_SITE_URL=https://posterfy.app
